# Бэкенд detail.web. По умолчанию — публичный прод (api.detailweb.ru).
# Для локальной разработки против своего FastAPI:
#   DETAILWEB_API_BASE=http://localhost:8000
DETAILWEB_API_BASE=https://api.detailweb.ru

# Ключ тарифа PRO+ и выше (формат dwa_...). Без него или на Free/PRO — free-результат.
# Получить: кабинет detail.web → Аккаунт → API-ключи.
# DETAILWEB_API_KEY=dwa_...

# Таймаут HTTP в секундах (deep-crawl может быть долгим).
# DETAILWEB_TIMEOUT=60

# Язык заголовков проверок по умолчанию: ru | en
# DETAILWEB_LANG=ru
